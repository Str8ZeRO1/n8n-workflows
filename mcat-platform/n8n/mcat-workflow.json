{
  "name": "MCAT Platform - Answer Analysis Workflow",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "mcat/submit-answer",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-trigger",
      "name": "Webhook - Submit Answer",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        250,
        300
      ],
      "webhookId": "mcat-submit-answer"
    },
    {
      "parameters": {
        "url": "=http://fastapi:8000/inference/analyze_attempt",
        "authentication": "none",
        "requestMethod": "POST",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "user_id",
              "value": "={{ $json.body.user_id }}"
            },
            {
              "name": "question_id",
              "value": "={{ $json.body.question_id }}"
            },
            {
              "name": "answer",
              "value": "={{ $json.body.answer }}"
            },
            {
              "name": "time_ms",
              "value": "={{ $json.body.time_ms }}"
            },
            {
              "name": "events",
              "value": "={{ $json.body.events }}"
            },
            {
              "name": "user_tier",
              "value": "={{ $json.body.user_tier }}"
            },
            {
              "name": "confidence_level",
              "value": "={{ $json.body.confidence_level }}"
            }
          ]
        },
        "options": {
          "timeout": 30000
        }
      },
      "id": "http-inference",
      "name": "FastAPI - Analyze Attempt",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        470,
        300
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}"
      },
      "id": "webhook-response",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        690,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{ $json.status }}",
              "operation": "equals",
              "value2": 200
            }
          ]
        }
      },
      "id": "if-success",
      "name": "Check Success",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        470,
        500
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO workflow_logs (workflow_name, execution_id, status, data, created_at) VALUES ('mcat_analysis', '{{ $execution.id }}', 'success', '{{ $json }}', NOW())",
        "options": {}
      },
      "id": "postgres-log",
      "name": "Log to Postgres",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [
        690,
        500
      ],
      "credentials": {
        "postgres": {
          "id": "1",
          "name": "MCAT Postgres"
        }
      }
    }
  ],
  "connections": {
    "Webhook - Submit Answer": {
      "main": [
        [
          {
            "node": "FastAPI - Analyze Attempt",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "FastAPI - Analyze Attempt": {
      "main": [
        [
          {
            "node": "Respond to Webhook",
            "type": "main",
            "index": 0
          },
          {
            "node": "Check Success",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Success": {
      "main": [
        [
          {
            "node": "Log to Postgres",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true,
  "settings": {
    "executionOrder": "v1"
  },
  "versionId": "1",
  "id": "mcat-platform-workflow",
  "meta": {
    "instanceId": "mcat-platform"
  },
  "tags": [
    {
      "name": "MCAT",
      "id": "1"
    },
    {
      "name": "Education",
      "id": "2"
    }
  ]
}
